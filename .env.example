# === AdverRocketBot Environment Variables ===
# Copy this file to .env and fill in your values

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=

# Admin Telegram User ID (numeric)
ADMIN_TELEGRAM_ID=

# Crypto Pay API Token (from @CryptoBot)
CRYPTO_PAY_API_TOKEN=

# Support username (without @)
SUPPORT_USERNAME=

# SQLite database path (default: /app/data/bot.db)
# DATABASE_PATH=/app/data/bot.db

# Crypto Pay API URL (mainnet by default)
# CRYPTO_PAY_API_URL=https://pay.crypt.bot/api

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_LEVEL=INFO
